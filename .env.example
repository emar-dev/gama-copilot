# Serveur applicatif
PORT=3000

# LLM local via Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3
OLLAMA_KEEP_ALIVE=30m

# Agent autonome (Semaine 4) — DOIT supporter les tool calls (pas llama3)
# ollama pull qwen2.5-coder:7b
OLLAMA_AGENT_MODEL=qwen2.5-coder:7b
AGENT_MAX_ITERATIONS=12
# AGENT_FORCE_RAG=false pour désactiver le RAG forcé sur les questions doc
# INCLUDE_SLOW=1 pour eval-agent / demo-mvp avec création de projet (lent)

# Modèle d'embeddings local (étape J4)
# all-minilm: rapide sur CPU (contexte ~256 tokens) -> chunks courts requis
# nomic-embed-text: meilleure qualité mais ~300x plus lent sur CPU
# Tirer via: ollama pull all-minilm
OLLAMA_EMBED_MODEL=all-minilm

# Index vectoriel généré (scripts/build-index.ts)
INDEX_PATH=data/gama-index.json
# Taille de chunk (chars). 400 convient au contexte d'all-minilm.
CHUNK_SIZE=400
# Garde-fou: tronque l'entrée d'embedding pour ne pas dépasser le contexte modèle.
EMBED_MAX_CHARS=480

# --- Base de données MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=gama_copilot
# Applique les migrations en attente au démarrage de l'API
DB_MIGRATIONS_RUN=true

# --- Authentification ---
# Deux secrets différents, 32 caractères minimum. Pour en générer un :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Jeton d'accès : 15 min. Session « Se souvenir de moi » : 30 jours. Sinon : 24 h.
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REMEMBER_DAYS=30
AUTH_SESSION_HOURS=24
# Tentatives de connexion/inscription par minute et par IP
AUTH_THROTTLE_LIMIT=10
BCRYPT_ROUNDS=12

# --- Cookies et CORS ---
# Origine(s) du front autorisée(s), séparées par des virgules
FRONT_ORIGIN=http://localhost:3001
# true obligatoire en production (HTTPS)
COOKIE_SECURE=false
# Domaine des cookies si le front et l'API sont sur des sous-domaines (ex. .labo.fr)
# COOKIE_DOMAIN=
# Derrière un reverse proxy : nombre de proxys de confiance (ex. 1)
# TRUST_PROXY=

# --- Réinitialisation du mot de passe et e-mails ---
# Page du front qui reçoit le lien (par défaut : FRONT_ORIGIN + /reset-password)
# PASSWORD_RESET_URL=http://localhost:3001/reset-password
RESET_TOKEN_TTL_MINUTES=30
# SMTP : obligatoire en production. En développement, sans SMTP_HOST,
# les e-mails (et donc les liens) sont affichés dans la console de l'API.
SMTP_HOST=
SMTP_PORT=587
# true pour le port 465 (TLS direct), false pour 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="GAMA-Copilot <no-reply@example.org>"

# --- Connexion avec Google / GitHub (OAuth) ---
# Adresse publique de l'API : sert à construire les URL de retour déclarées chez Google et GitHub
#   Google : <API_PUBLIC_URL>/auth/oauth/google/callback
#   GitHub : <API_PUBLIC_URL>/auth/oauth/github/callback
API_PUBLIC_URL=http://localhost:3000
# Laisser vide pour désactiver un fournisseur (le bouton affiche alors un message clair).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

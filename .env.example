# Serveur applicatif
PORT=3000

# LLM local via Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3
OLLAMA_KEEP_ALIVE=30m

# Agent autonome (Semaine 4) — DOIT supporter les tool calls (pas llama3)
# ollama pull qwen2.5-coder:7b
OLLAMA_AGENT_MODEL=qwen2.5-coder:7b
AGENT_MAX_ITERATIONS=12
# AGENT_FORCE_RAG=false pour désactiver le RAG forcé sur les questions doc
# INCLUDE_SLOW=1 pour eval-agent / demo-mvp avec création de projet (lent)

# Modèle d'embeddings local (étape J4)
# all-minilm: rapide sur CPU (contexte ~256 tokens) -> chunks courts requis
# nomic-embed-text: meilleure qualité mais ~300x plus lent sur CPU
# Tirer via: ollama pull all-minilm
OLLAMA_EMBED_MODEL=all-minilm

# Index vectoriel généré (scripts/build-index.ts)
INDEX_PATH=data/gama-index.json
# Taille de chunk (chars). 400 convient au contexte d'all-minilm.
CHUNK_SIZE=400
# Garde-fou: tronque l'entrée d'embedding pour ne pas dépasser le contexte modèle.
EMBED_MAX_CHARS=480
